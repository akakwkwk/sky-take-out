page {
  background-color: #f0f0f0;
  height: 100%;
}

.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 消息列表 */
.chat-list {
  flex: 1;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.message-item {
  display: flex;
  margin-bottom: 36rpx;
  animation: slideIn 0.25s ease-out;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.ai .avatar {
  background: #ffc200;
  color: #fff;
}

.user {
  flex-direction: row-reverse;
}

.user .avatar {
  background: #555;
  color: #fff;
}

.content-box {
  max-width: 72%;
  margin: 0 18rpx;
}

.content {
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-line;
}

.ai .content {
  background: #fff;
  color: #333;
  border-radius: 4rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.user .content {
  background: #ffc200;
  color: #fff;
  border-radius: 24rpx 4rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255,194,0,0.25);
}

.thinking {
  color: #999;
}

.dot-anim {
  animation: dotPulse 1.2s infinite;
}

@keyframes dotPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

/* 快捷回复 */
.quick-replies {
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.quick-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-btn {
  padding: 14rpx 28rpx;
  background: #fff7e6;
  border: 1rpx solid #ffc200;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #e69500;
}

.quick-btn:active {
  background: #ffc200;
  color: #fff;
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 35rpx;
  font-size: 28rpx;
}

.placeholder-style {
  color: #bbb;
}

.send-btn {
  width: 140rpx !important;
  height: 80rpx;
  background: #ffc200;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 0;
  border: none;
  line-height: 80rpx;
}

.send-btn:active {
  opacity: 0.8;
}
